{
  "name": "@cryptoapis-io/x402-merchant-sdk",
  "version": "0.3.0",
  "description": "CryptoAPIs x402 merchant SDK — monetize any API per-request with the x402 protocol via the CryptoAPIs facilitator (framework-agnostic core + Express middleware).",
  "license": "MIT",
  "author": "Crypto APIs, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/CryptoAPIs-io/cryptoapis-x402-merchant-sdk.git"
  },
  "homepage": "https://developers.cryptoapis.io",
  "keywords": [
    "x402",
    "payments",
    "cryptoapis",
    "usdc",
    "stablecoin",
    "express",
    "hono",
    "nextjs",
    "middleware",
    "micropayments"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./express": {
      "types": "./types/express.d.ts",
      "import": "./src/express.js"
    },
    "./hono": {
      "types": "./types/hono.d.ts",
      "import": "./src/hono.js"
    },
    "./next": {
      "types": "./types/next.d.ts",
      "import": "./src/next.js"
    },
    "./mcp": {
      "types": "./types/mcp.d.ts",
      "import": "./src/mcp.js"
    },
    "./a2a": {
      "types": "./types/a2a.d.ts",
      "import": "./src/a2a.js"
    }
  },
  "files": [
    "src",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint ./src/ ./tests/",
    "prepublishOnly": "npm run lint && npm test && npm run build:types",
    "build:types": "tsc"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^46.10.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "types": "./types/index.d.ts"
}
